<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>antibotstarter-server-7c1f2a9e</UserSecretsId>
    <!-- "Angular and ASP.NET Core" template: the server launches the Angular dev server through SpaProxy -->
    <SpaRoot>..\antibotstarter.client</SpaRoot>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:63421</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="RedisRateLimiting.AspNetCore" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiBotStarter.Application\AntiBotStarter.Application.csproj" />
    <ProjectReference Include="..\AntiBotStarter.Domain\AntiBotStarter.Domain.csproj" />
    <ProjectReference Include="..\AntiBotStarter.Infrastructure\AntiBotStarter.Infrastructure.csproj" />
    <ProjectReference Include="..\antibotstarter.client\antibotstarter.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AntiBotStarter.Server.IntegrationTests" />
  </ItemGroup>

</Project>
