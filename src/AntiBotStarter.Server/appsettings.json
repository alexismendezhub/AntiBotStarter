{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AntiBotStarter.Server.Security.SecurityEvents": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "DataProtection": {
    "KeyVaultKeyId": ""
  },
  "Distributed": {
    "RedisConnectionString": "",
    "KeyPrefix": "abs:",
    "SingleInstance": false
  },
  "Email": {
    "Transport": "Log",
    "FromAddress": "",
    "FromName": "AntiBotStarter",
    "Paused": false,
    "BlockDisposableDomains": true,
    "ExtraBlockedDomains": [],
    "RetentionDays": 7,
    "Throttle": {
      "PerRecipientMinMinutes": 15,
      "PerRecipientPerDay": 3,
      "GlobalPerHour": 200,
      "GlobalPerDay": 1000,
      "GlobalWarningPercent": 80
    },
    "Dispatcher": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "LockMinutes": 2
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Username": "",
      "Password": ""
    },
    "AzureCommunicationServices": {
      "ConnectionString": "",
      "Endpoint": ""
    }
  },
  "AntiBot": {
    "AllowSearchEngines": false,
    "ExemptPaths": [
      "/health",
      "/robots.txt"
    ],
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
    "AllowedCorsOrigins": [],
    "RateLimits": {
      "GlobalPermitPerMinute": 120,
      "AuthPermitPerMinute": 5,
      "ApiTokenLimit": 30,
      "ApiTokensPerPeriod": 10,
      "ApiReplenishSeconds": 10
    },
    "BotFilter": {
      "Enabled": true,
      "BlockEmptyUserAgent": true,
      "BlockAiCrawlers": true,
      "BlockedUserAgentFragments": [
        "python-requests",
        "python-urllib",
        "aiohttp",
        "httpx",
        "curl/",
        "wget/",
        "libwww-perl",
        "go-http-client",
        "java/",
        "okhttp",
        "apache-httpclient",
        "scrapy",
        "node-fetch",
        "axios/",
        "headlesschrome",
        "phantomjs",
        "selenium",
        "puppeteer",
        "playwright",
        "ahrefsbot",
        "semrushbot",
        "mj12bot",
        "dotbot",
        "petalbot",
        "blexbot",
        "dataforseobot",
        "serpstatbot",
        "zoominfobot",
        "seokicks",
        "megaindex",
        "masscan",
        "zgrab",
        "nmap",
        "sqlmap",
        "nikto",
        "nuclei"
      ],
      "AiCrawlerUserAgents": [
        "GPTBot",
        "ChatGPT-User",
        "OAI-SearchBot",
        "CCBot",
        "ClaudeBot",
        "Claude-Web",
        "Claude-SearchBot",
        "Claude-User",
        "anthropic-ai",
        "PerplexityBot",
        "Perplexity-User",
        "Bytespider",
        "Amazonbot",
        "Google-CloudVertexBot",
        "Meta-ExternalAgent",
        "Meta-ExternalFetcher",
        "FacebookBot",
        "Diffbot",
        "cohere-ai",
        "cohere-training-data-crawler",
        "YouBot",
        "Timpibot",
        "ImagesiftBot",
        "omgili",
        "AI2Bot",
        "MistralAI-User",
        "DuckAssistBot"
      ],
      "RobotsOnlyAiTokens": [
        "Google-Extended",
        "Applebot-Extended"
      ],
      "SearchEngines": [
        {
          "UserAgentFragment": "Googlebot",
          "AllowedHostSuffixes": [
            ".googlebot.com",
            ".google.com",
            ".googleusercontent.com"
          ]
        },
        {
          "UserAgentFragment": "bingbot",
          "AllowedHostSuffixes": [
            ".search.msn.com"
          ]
        },
        {
          "UserAgentFragment": "Applebot",
          "AllowedHostSuffixes": [
            ".applebot.apple.com"
          ]
        },
        {
          "UserAgentFragment": "YandexBot",
          "AllowedHostSuffixes": [
            ".yandex.ru",
            ".yandex.net",
            ".yandex.com"
          ]
        }
      ]
    },
    "CrawlerTrap": {
      "Enabled": true,
      "Path": "/_internal/archive",
      "BlockMinutes": 1440
    },
    "Forms": {
      "MinSecondsToSubmit": 3,
      "MaxMinutesValid": 30
    },
    "Captcha": {
      "Enabled": true,
      "SiteKey": "",
      "SecretKey": "",
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
      "ExpectedHostnames": []
    },
    "OriginLock": {
      "Enabled": false,
      "HeaderName": "X-Azure-FDID",
      "ExpectedValues": [],
      "ExemptPaths": [
        "/health"
      ]
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardedForHeaderName": "X-Forwarded-For",
      "ForwardLimit": 1
    },
    "Scraping": {
      "RequireAuthForData": true,
      "MaxPageSize": 50,
      "MaxPage": 20
    },
    "PwnedPasswords": {
      "Enabled": true,
      "FailClosed": false
    }
  }
}
