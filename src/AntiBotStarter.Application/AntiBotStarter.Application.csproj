<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiBotStarter.Domain\AntiBotStarter.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AntiBotStarter.Application.UnitTests" />
    <InternalsVisibleTo Include="AntiBotStarter.Server.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- github.com/disposable-email-domains/disposable-email-domains (CC0-1.0) -->
    <EmbeddedResource Include="Email\disposable_email_blocklist.conf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same implicit usings as the Web SDK, so code reads the same in every layer -->
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
